# ==============================================================================
# IQAC Management System — Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env, or use environment-specific files:
#   - .env.development: Local developer machine
#   - .env.test: Automated testing & CI
#   - .env.production.example: Production deployment template
# ==============================================================================

# Core Django
SECRET_KEY=django-insecure-change-me-in-production-iqac-management-system
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
MAINTENANCE_MODE=False

# PostgreSQL Database
DB_NAME=iqac_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=600

# CORS & CSRF
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@iqac.local

# Storage (Set USE_S3=True for S3 / MinIO in production)
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1

# Redis & Background Queue
REDIS_URL=redis://localhost:6379/0

# AI Intelligence
AI_ENABLED=True
AI_PROVIDER=heuristic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
