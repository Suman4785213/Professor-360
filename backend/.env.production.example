# ==============================================================================
# IQAC Management System — Production Environment Configuration (.env.production)
# ==============================================================================
# CAUTION: NEVER commit the active .env.production file containing real credentials!
# Populate this file on your deployment server with secure, randomized values.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DJANGO CORE & SECURITY SETTINGS
# ------------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=generate-a-strong-50-character-secret-key-for-production-deployment

# Production MUST always be False
DEBUG=False

# Comma-separated list of fully qualified domain names and IP addresses
ALLOWED_HOSTS=iqac.yourdomain.edu,api.iqac.yourdomain.edu,127.0.0.1

# Enforce HTTPS redirect (Set to True behind SSL termination)
SECURE_SSL_REDIRECT=True

# Maintenance Mode toggle (True: blocks non-admin traffic with 503)
MAINTENANCE_MODE=False

# ------------------------------------------------------------------------------
# 2. DATABASE (PostgreSQL)
# ------------------------------------------------------------------------------
DB_NAME=iqac_production_db
DB_USER=iqac_prod_user
DB_PASSWORD=replace-with-a-secure-complex-database-password
DB_HOST=postgres
DB_PORT=5432
DB_CONN_MAX_AGE=600

# ------------------------------------------------------------------------------
# 3. CORS & CSRF TRUSTED ORIGINS
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://iqac.yourdomain.edu,https://api.iqac.yourdomain.edu
CSRF_TRUSTED_ORIGINS=https://iqac.yourdomain.edu,https://api.iqac.yourdomain.edu

# ------------------------------------------------------------------------------
# 4. REDIS & BACKGROUND WORKERS (Celery / Caching)
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ------------------------------------------------------------------------------
# 5. S3-COMPATIBLE FILE STORAGE (AWS S3, MinIO, Wasabi, Cloudflare R2)
# ------------------------------------------------------------------------------
USE_S3=True
AWS_ACCESS_KEY_ID=your-aws-or-minio-access-key
AWS_SECRET_ACCESS_KEY=your-aws-or-minio-secret-key
AWS_STORAGE_BUCKET_NAME=iqac-production-evidence
AWS_S3_REGION_NAME=ap-south-1
AWS_S3_CUSTOM_DOMAIN=
AWS_S3_ENDPOINT_URL=

# ------------------------------------------------------------------------------
# 6. TRANSACTIONAL EMAIL (SMTP)
# ------------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your-smtp-api-key
DEFAULT_FROM_EMAIL=IQAC Notifications <noreply@iqac.yourdomain.edu>

# ------------------------------------------------------------------------------
# 7. AI & OCR INTELLIGENCE (Phase 7)
# ------------------------------------------------------------------------------
AI_ENABLED=True
AI_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 8. RATE LIMITING & LOGGING
# ------------------------------------------------------------------------------
DJANGO_LOG_LEVEL=INFO
RATE_LIMIT_ANON=100/min
RATE_LIMIT_USER=1000/min
RATE_LIMIT_LOGIN=10/min
RATE_LIMIT_AI=30/min
RATE_LIMIT_REPORTS=20/min
